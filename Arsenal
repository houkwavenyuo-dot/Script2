-- 5. ระบบลดแรงดีดปืน
local lastCamCFrame = Camera.CFrame
local recoilConn
CreateToggleOption(tabCombat, "5. Enable No Recoil / Control", function(v)
    if v then
        recoilConn = RunService.RenderStepped:Connect(function()
            local currentCFrame = Camera.CFrame
            if recoilControlPercent < 100 then
                local diff = currentCFrame - lastCamCFrame
                local multiplier = (100 - recoilControlPercent) / 100
                if diff.LookVector.Y > 0 then
                    Camera.CFrame = Camera.CFrame * CFrame.Angles(-diff.LookVector.Y * multiplier, 0, 0)
                end
            end
            lastCamCFrame = Camera.CFrame
        end)
        SendDigitalNotification("COMBAT", "Recoil Control Enabled", 3)
    else
        if recoilConn then recoilConn:Disconnect() end
        SendDigitalNotification("COMBAT", "Recoil Control Disabled", 3)
    end
end)

